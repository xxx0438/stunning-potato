# === 基础 ===
ECHO_DATABASE_URL=sqlite:///./echo_prompt_manager.db
ECHO_CORS_ORIGINS=*
ECHO_LOG_LEVEL=INFO
ECHO_LOG_FORMAT=json   # json | console

# === 后台 Worker ===
ECHO_TELEMETRY_FLUSH_INTERVAL=30
ECHO_LOCK_CLEANUP_INTERVAL=60
ECHO_TELEMETRY_BATCH_SIZE=20
# ECHO_DISABLE_WORKERS=1

# === GitLab ===
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=
ECHO_GITLAB_ALLOWED_HOSTS=gitlab.com

# === Datadog ===
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com
