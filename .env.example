# === Auth ===
ECHO_AUTH_MODE=demo                  # demo | jwt
ECHO_JWT_SECRET=
ECHO_JWT_ISSUER=echo-local
ECHO_JWT_AUDIENCE=
ECHO_DEFAULT_TENANT_ID=default
ECHO_DEMO_TOKEN_ENABLED=1

# === Database ===
ECHO_DATABASE_URL=sqlite:///./echo_prompt_manager.db
ECHO_AUTO_CREATE_TABLES=1

# === Logging ===
ECHO_LOG_LEVEL=INFO
ECHO_LOG_FORMAT=json

# === Background workers ===
ECHO_TELEMETRY_FLUSH_INTERVAL=30
ECHO_LOCK_CLEANUP_INTERVAL=60
ECHO_TELEMETRY_BATCH_SIZE=20

# === CORS / SSRF ===
ECHO_CORS_ORIGINS=*
ECHO_GITLAB_ALLOWED_HOSTS=gitlab.com

# === M4 OpenTelemetry ===
ECHO_OTEL_ENABLED=0
ECHO_OTEL_SERVICE_NAME=echo-agent-governance
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# === M5 Prometheus ===
ECHO_METRICS_ENABLED=1

# === M6 Rate limit ===
ECHO_RATELIMIT_ENABLED=0
ECHO_RATELIMIT_PER_MINUTE=120
ECHO_RATELIMIT_BURST=30

# === M7 Hash chain ===
ECHO_HASHCHAIN_ENABLED=1
ECHO_HASHCHAIN_SECRET=

# === External integrations ===
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=
DD_API_KEY=
DD_SITE=datadoghq.com
